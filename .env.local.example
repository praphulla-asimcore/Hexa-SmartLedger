# ─────────────────────────────────────────────────────────────────────────────
# Hexa SmartLedger — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic Claude API key
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the Claude model (default is claude-sonnet-4-6)
# CLAUDE_MODEL=claude-sonnet-4-6

# Optional: Next.js public base URL (for production deployments)
# NEXT_PUBLIC_BASE_URL=https://smartledger.yourdomain.com
